# Telegram MTProto API credentials (obtain from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Web console listen address (keep bound to 127.0.0.1 behind a reverse proxy)
WEB_LISTEN=127.0.0.1:28081

# Optional: override base data/config directory (defaults to repo directory)
# TG_FWD_DIR=/opt/tg-forwarder
